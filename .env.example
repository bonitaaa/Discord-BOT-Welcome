DISCORD_TOKEN=
# Facultatif : Welcomer utilise automatiquement son propre identifiant si cette variable est absente.
CLIENT_ID=
GUILD_ID=

# Pause globale : laisse false pour ne rien envoyer aux nouveaux membres.
WELCOME_ENABLED=false

# Facultatif : /welcome-config permet aussi de choisir le salon depuis Discord.
WELCOME_CHANNEL_ID=
OWNER_IDS=317270244815011840,1526355772831957012
DATA_DIR=/data

# Correspondances facultatives : un choix sans rôle reste enregistré normalement.
# Exemple : {"france":"123", "belgique":"456"}
COUNTRY_ROLE_IDS={}
GENDER_ROLE_IDS={}
AGE_ROLE_IDS={}
NOTIFICATION_ROLE_IDS={}

